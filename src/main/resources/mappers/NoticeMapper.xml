<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.co.greengarden.mapper.NoticeMapper">

    <!-- 검색 조건 재사용 -->
    <sql id="searchWhere">
        <where>
            <!-- 유형 필터 -->
            <if test="pageRequestDTO.type != null and pageRequestDTO.type != ''">
                AND TYPE = #{pageRequestDTO.type}
            </if>

            <!-- 검색 조건 -->
            <if test="pageRequestDTO.searchType != null and pageRequestDTO.keyword != null and pageRequestDTO.keyword != ''">
                <choose>
                    <when test="pageRequestDTO.searchType == 'title'">
                        AND TITLE LIKE '%' || #{pageRequestDTO.keyword} || '%'
                    </when>
                    <when test="pageRequestDTO.searchType == 'content'">
                        AND CONTENT LIKE '%' || #{pageRequestDTO.keyword} || '%'
                    </when>
                    <when test="pageRequestDTO.searchType == 'titleContent'">
                        AND (TITLE LIKE '%' || #{pageRequestDTO.keyword} || '%'
                        OR CONTENT LIKE '%' || #{pageRequestDTO.keyword} || '%')
                    </when>
                </choose>
            </if>
        </where>
    </sql>

    <!-- 공지사항 목록 조회 (페이징) -->
    <select id="selectNoticeList" resultType="kr.co.greengarden.dto.NoticeDTO">
        SELECT
        NOTICE_ID as noticeId,
        TYPE as type,
        TITLE as title,
        CONTENT as content,
        VIEWS as views,
        CREATED_AT as createdAt
        FROM TB_NOTICE
        <include refid="searchWhere"/>
        ORDER BY CREATED_AT DESC
        OFFSET #{pageRequestDTO.offset} ROWS
        FETCH NEXT #{pageRequestDTO.size} ROWS ONLY
    </select>

    <!-- 전체 개수 조회 -->
    <select id="selectNoticeCount" resultType="int">
        SELECT COUNT(*)
        FROM TB_NOTICE
        <include refid="searchWhere"/>
    </select>

    <!-- 상세보기 -->
    <select id="selectNotice" resultType="kr.co.greengarden.dto.NoticeDTO">
        SELECT
        NOTICE_ID as noticeId,
        TYPE as type,
        TITLE as title,
        CONTENT as content,
        VIEWS as views,
        CREATED_AT as createdAt
        FROM TB_NOTICE
        WHERE NOTICE_ID = #{noticeId}
    </select>

    <!-- 조회수 증가 -->
    <update id="updateViews">
        UPDATE TB_NOTICE
        SET VIEWS = VIEWS + 1
        WHERE NOTICE_ID = #{noticeId}
    </update>

    <!--index 5개 가져오기-->
    <select id="selectLatestNotices" resultType="kr.co.greengarden.dto.NoticeDTO">
        SELECT
        NOTICE_ID AS noticeId,
        TITLE AS title,
        CREATED_AT AS createdAt
        FROM TB_NOTICE
        ORDER BY CREATED_AT DESC
        FETCH NEXT #{limit} ROWS ONLY
    </select>

</mapper>
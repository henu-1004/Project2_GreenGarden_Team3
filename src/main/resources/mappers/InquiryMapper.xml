<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.co.greengarden.mapper.InquiryMapper">

    <sql id="searchWhere">
        <where>
            <if test="pageRequestDTO.category1 != null and pageRequestDTO.category1 != ''">
                AND CATEGORY1 = #{pageRequestDTO.category1}
            </if>

            <if test="pageRequestDTO.category2 != null and pageRequestDTO.category2 != ''">
                AND CATEGORY2 = #{pageRequestDTO.category2}
            </if>

            <if test="pageRequestDTO.type != null and pageRequestDTO.type != ''">
                AND CATEGORY1 = #{pageRequestDTO.type}
            </if>

            <if test="pageRequestDTO.searchType != null and pageRequestDTO.keyword != null and pageRequestDTO.keyword != ''">
                <choose>
                    <when test="pageRequestDTO.searchType == 'T'">
                        AND TITLE LIKE '%' || #{pageRequestDTO.keyword} || '%'
                    </when>
                    <when test="pageRequestDTO.searchType == 'C'">
                        AND CONTENT LIKE '%' || #{pageRequestDTO.keyword} || '%'
                    </when>
                    <when test="pageRequestDTO.searchType == 'W'">
                        AND WRITER LIKE '%' || #{pageRequestDTO.keyword} || '%'
                    </when>
                    <otherwise>
                        AND (TITLE LIKE '%' || #{pageRequestDTO.keyword} || '%'
                        OR CONTENT LIKE '%' || #{pageRequestDTO.keyword} || '%')
                    </otherwise>
                </choose>
            </if>
        </where>
    </sql>

    <!-- 문의 목록 조회 (페이징, 검색 포함) -->
    <select id="selectInquiryList" resultType="kr.co.greengarden.dto.InquiryDTO">
        SELECT *
        FROM (
        SELECT
        INQUIRY_ID as inquiryId,
        CATEGORY1 as category1,
        CATEGORY2 as category2,
        TITLE as title,
        WRITER as writer,
        CREATED_AT as createdAt,
        STATUS as status,
        CONTENT as content,
        ANSWER as answer,
        CHANNEL as channel,
        ROWNUM AS RN
        FROM TB_INQUIRY
        <include refid="searchWhere"/>
        ORDER BY INQUIRY_ID DESC
        )
        <!-- 페이징 조건: DTO의 'pg' 필드를 사용하도록 통일 -->
        WHERE RN &gt; (#{pageRequestDTO.pg} - 1) * #{pageRequestDTO.size}
        AND RN &lt;= #{pageRequestDTO.pg} * #{pageRequestDTO.size}
    </select>

    <!-- 문의 전체 건수 조회 (페이징 계산용) -->
    <select id="selectInquiryCount" resultType="int">
        SELECT COUNT(INQUIRY_ID)
        FROM TB_INQUIRY
        <include refid="searchWhere"/>
    </select>

    <!-- 문의 단일 건 조회 -->
    <select id="selectInquiry" resultType="kr.co.greengarden.dto.InquiryDTO">
        SELECT
        INQUIRY_ID as inquiryId,
        CATEGORY1 as category1,
        CATEGORY2 as category2,
        TITLE as title,
        WRITER as writer,
        CREATED_AT as createdAt,
        STATUS as status,
        CONTENT as content,
        ANSWER as answer,
        CHANNEL as channel
        FROM TB_INQUIRY
        WHERE INQUIRY_ID = #{inquiryId}
    </select>

    <!--index 5개 가져오기-->
    <select id="selectLatestInquiry" resultType="kr.co.greengarden.dto.InquiryDTO">
        SELECT
        INQUIRY_ID AS inquiryId,
        TITLE AS title,
        WRITER AS writer,
        CREATED_AT as createdAt
        FROM TB_INQUIRY
        ORDER BY CREATED_AT DESC
        FETCH NEXT #{limit} ROWS ONLY
    </select>

</mapper>

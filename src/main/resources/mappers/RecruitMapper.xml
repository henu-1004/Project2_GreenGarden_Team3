<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.co.greengarden.mapper.RecruitMapper">

    <!-- ==============================
          🔍 검색 조건 공통
     ============================== -->
    <sql id="searchWhere">
        <where>
            <if test="pageRequestDTO.searchType != null
                      and pageRequestDTO.keyword != null
                      and pageRequestDTO.keyword != ''">
                <choose>
                    <!-- 🔢 채용번호 검색 (문자열 → 숫자 변환) -->
                    <when test="pageRequestDTO.searchType == 'id'">
                        AND RECRUIT_ID = TO_NUMBER(#{pageRequestDTO.keyword})
                    </when>

                    <!-- 🏢 채용부서 -->
                    <when test="pageRequestDTO.searchType == 'department'">
                        AND DEPARTMENT LIKE '%' || #{pageRequestDTO.keyword} || '%'
                    </when>

                    <!-- 💼 채용형태 -->
                    <when test="pageRequestDTO.searchType == 'type'">
                        AND TYPE LIKE '%' || #{pageRequestDTO.keyword} || '%'
                    </when>

                    <!-- 📄 제목 -->
                    <when test="pageRequestDTO.searchType == 'title'">
                        AND TITLE LIKE '%' || #{pageRequestDTO.keyword} || '%'
                    </when>
                </choose>
            </if>
        </where>
    </sql>

    <!-- ==============================
          📋 채용 목록 조회 (페이징 + 검색)
     ============================== -->
    <select id="selectRecruitList" resultType="kr.co.greengarden.dto.RecruitDTO">
        SELECT
        RECRUIT_ID AS recruitId,
        DEPARTMENT AS department,
        CAREER AS career,
        TYPE AS type,
        TITLE AS title,
        WRITER AS writer,
        STATUS AS status,
        PERIOD AS period,
        CREATED_AT AS createdAt,
        NOTE AS note
        FROM TB_RECRUIT
        <include refid="searchWhere"/>
        ORDER BY RECRUIT_ID DESC
        OFFSET #{pageRequestDTO.offset} ROWS
        FETCH NEXT #{pageRequestDTO.size} ROWS ONLY
    </select>

    <!-- ==============================
          🧮 총 건수 조회
     ============================== -->
    <select id="selectRecruitCount" resultType="int">
        SELECT COUNT(RECRUIT_ID)
        FROM TB_RECRUIT
        <include refid="searchWhere"/>
    </select>

    <!-- ==============================
          🔎 단일 공고 조회
     ============================== -->
    <select id="selectRecruit" resultType="kr.co.greengarden.dto.RecruitDTO">
        SELECT
        RECRUIT_ID AS recruitId,
        DEPARTMENT AS department,
        CAREER AS career,
        TYPE AS type,
        TITLE AS title,
        WRITER AS writer,
        STATUS AS status,
        PERIOD AS period,
        CREATED_AT AS createdAt,
        NOTE AS note
        FROM TB_RECRUIT
        WHERE RECRUIT_ID = #{recruitId}
    </select>

    <!-- ==============================
          🕓 최신 채용공고 5개 (홈 or 관리자용)
     ============================== -->
    <select id="selectLatestRecruit" resultType="kr.co.greengarden.dto.RecruitDTO">
        SELECT
        RECRUIT_ID AS recruitId,
        TITLE AS title,
        WRITER AS writer,
        CREATED_AT AS createdAt,
        STATUS AS status
        FROM TB_RECRUIT
        ORDER BY CREATED_AT DESC
        FETCH NEXT #{limit} ROWS ONLY
    </select>

</mapper>
